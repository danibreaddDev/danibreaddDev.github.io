---
import Navigation from "./Navigation.astro";
import SwitchLanguage from "./SwitchLanguage.astro";
import Presentation from "./about/Presentation.astro";
const currentPath = Astro.url.pathname;
let frase = "";
let subfrase = "";
if (currentPath === "/") {
  frase = "Hola soy Dani";
  subfrase =
    "Valenciano, coder y con ojo para el detalle (en el código y en la ropa).";
} else {
  frase = "Hello, I'm Dani";
  subfrase =
    " Valencian, coder and with an eye for detail (in code and in clothes).";
}
---

<header class="container mx-auto max-w-4xl p-2 sm:p-5 flex flex-col gap-20">
  <div
    class="flex flex-row justify-center flex-wrap sm:justify-between w-full gap-10 md:gap-20"
  >
    <Navigation />
    <SwitchLanguage currentPath={currentPath} />
  </div>
  <div
    class="flex flex-col md:flex-row gap-10 sm:gap-5 justify-center items-center"
  >
    <img src="/icon.webp" alt="" class="size-48 sm:size-60 md:size-96" />
    <Presentation frase={frase} subfrase={subfrase} />
  </div>
</header>
