---
interface Props {
  frase: string;
  subfrase: string;
}

const { frase, subfrase } = Astro.props;
---

<section class="leading-loose flex flex-col gap-2">
  <p class="text-3xl md:text-5xl font-black dark:text-gray-200">
    {frase}
  </p>

  <p
    class="lg:text-balance text-base md:text-lg lg:text-xl font-light text-neutral-600 dark:text-neutral-200"
  >
    {subfrase}
  </p>
</section>
